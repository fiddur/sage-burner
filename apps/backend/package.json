{
  "name": "sage-burner-backend",
  "version": "0.1.0",
  "private": true,
  "license": "AGPL-3.0-or-later",
  "type": "module",
  "scripts": {
    "start": "node src/server.ts",
    "dev": "node --watch src/server.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node src/db/migrate-cli.ts",
    "test": "vitest run",
    "check": "tsc --noEmit && oxlint -c ../../.oxlintrc.json --type-aware",
    "fix": "oxfmt . && oxlint -c ../../.oxlintrc.json --fix",
    "admin:create": "node src/cli/create-admin.ts",
    "pantry:import": "node src/cli/import-pantry.ts"
  },
  "dependencies": {
    "@fastify/helmet": "^13.2.0",
    "@fastify/proxy-addr": "^5.1.2",
    "@fastify/static": "^10.1.7",
    "@sage-burner/shared": "workspace:*",
    "@simplewebauthn/server": "^14.0.3",
    "drizzle-orm": "1.0.0-rc.5",
    "fastify": "^5.12.7",
    "nodemailer": "^10.2.1",
    "web-push": "^3.6.7",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^24",
    "@types/web-push": "^3.6.4",
    "drizzle-kit": "1.0.0-rc.5",
    "vitest": "^5"
  }
}
