{
  "name": "sage-burner-backend",
  "version": "0.1.0",
  "private": true,
  "license": "AGPL-3.0-or-later",
  "type": "module",
  "scripts": {
    "start": "node src/server.ts",
    "dev": "node --watch src/server.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node src/db/migrate-cli.ts",
    "test": "vitest run",
    "check": "tsgo --noEmit && oxlint -c ../../.oxlintrc.json --type-aware",
    "fix": "oxfmt . && oxlint -c ../../.oxlintrc.json --fix",
    "admin:create": "node src/cli/create-admin.ts"
  },
  "dependencies": {
    "@fastify/helmet": "^13.1.0",
    "@fastify/proxy-addr": "^5.1.0",
    "@fastify/static": "^10.1.3",
    "@sage-burner/shared": "workspace:*",
    "@simplewebauthn/server": "^13.3.2",
    "drizzle-orm": "1.0.0-rc.5-169397b",
    "fastify": "^5.12.0",
    "nodemailer": "^9.0.5",
    "web-push": "^3.6.7",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^26",
    "@types/nodemailer": "^8.0.1",
    "@types/web-push": "^3.6.4",
    "drizzle-kit": "1.0.0-rc.5-ab785fc",
    "vitest": "^4"
  }
}
