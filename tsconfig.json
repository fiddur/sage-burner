{
  "extends": "@tsconfig/node24/tsconfig.json",
  "compilerOptions": {
    // Node runs our TypeScript directly via type stripping, so nothing here is
    // ever emitted — but the flags below keep the source strippable.
    "erasableSyntaxOnly": true,
    "verbatimModuleSyntax": true,
    "rewriteRelativeImportExtensions": true,
    "noEmit": true,
    // `strict` alone lets `arr[0]` and `record[key]` type as present when they
    // may not be. Both are everywhere here — answers keyed by question id,
    // query results indexed by position — so the lookup should be honest.
    "noUncheckedIndexedAccess": true
  }
}
