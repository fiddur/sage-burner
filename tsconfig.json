{
  "extends": "@tsconfig/node24/tsconfig.json",
  "compilerOptions": {
    // Node runs our TypeScript directly via type stripping, so nothing here is
    // ever emitted — but the flags below keep the source strippable.
    "erasableSyntaxOnly": true,
    "verbatimModuleSyntax": true,
    "rewriteRelativeImportExtensions": true,
    "noEmit": true
  }
}
