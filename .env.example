# Copy to .env and edit. Every variable is optional — the image ships with
# working defaults — so this file exists to document what can be changed, not to
# list things you must fill in.
#
# An empty value is treated as unset. `FOO: ${FOO}` in a compose file with FOO
# undefined expands to an empty string rather than to nothing, and a defaulted
# variable should not lose to that.

# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info

# --- Set in the image; listed here so the defaults are visible -------------
#
# Overriding these in a normal deployment is usually a mistake.
#
# DATABASE_URL=/data/sage-burner.sqlite   # on the named volume
# WEB_ROOT=/app/apps/web/dist             # the built frontend
# HOST=0.0.0.0                            # must stay reachable inside Docker
# PORT=3000                               # the compose file maps to this
#
# How much of X-Forwarded-For to believe. `1` is correct behind exactly one
# header-appending proxy, which is what Apache is here — see the README. `true`
# would let any client claim any address; `false` makes every request look like
# it came from the Docker bridge.
# TRUST_PROXY=1
