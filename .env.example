# Copy to .env and edit.
#
# Compose reads this file for **variable substitution only** — it does not hand
# it to the container. So a name here has an effect only if docker-compose.yml
# references it as `${NAME}`. The two below do; anything else you add here will
# be silently ignored unless you wire it up there too.

# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info

# How much of X-Forwarded-For to believe.
#
# Ships as `false`, because copying this file is a documented step: shipping
# `1` would hand a trusted hop to everyone who follows the README, including
# anyone running compose without a proxy. With nothing appending to the header,
# one trusted hop makes `request.ip` — and `request.protocol` — whatever the
# client sends. That matters for logging and for anything keyed on the address.
#
# It does NOT decide the session cookie's Secure flag: nothing reads
# `request.protocol` when building the cookie. That comes from `secure_cookies`
# in config.ts, set whenever NODE_ENV is production, HOST is not loopback, or
# WEB_ROOT is set — all three of which the image sets.
#
# Set it to 1 when exactly one header-appending reverse proxy sits in front,
# which is the documented Apache setup. It is spoof-resistant there: a client
# can only prepend to the header, and Apache appends what it saw. `true` would
# trust the whole chain and let any client claim any address.
#
# One assignment, edited in place — not a second uncommented line. Compose's
# dotenv takes the last occurrence, so two lines would work, but the file would
# read top-down as though trust were off.
TRUST_PROXY=false

# Signing key for session cookies. REQUIRED in production — the app refuses to
# start without it rather than generating one at boot, which would look like it
# works and silently log every member out on each deploy. With watchtower
# redeploying on a tag move, that is every few minutes after a merge.
#
#   openssl rand -base64 48
#
# Changing it logs everyone out, which is also the only way to revoke a session:
# tokens are signed rather than stored, so there is nothing server-side to
# delete. Keep it out of version control.
SESSION_SECRET=

# How long a session lasts, in seconds. Two weeks by default.
#SESSION_TTL_SECONDS=1209600

# Where a browser reaches this installation. Only passkeys read it, and they read
# it because WebAuthn binds a credential to one domain and hands it to no other —
# so the domain has to be settled and stay settled. Left unset, each ceremony
# takes the browser's own Origin header, which works; docs/configuration.md says what that
# costs. Scheme and host, no trailing path.
#PUBLIC_ORIGIN=https://burn.example.org

# --- Fixed by the image ----------------------------------------------------
#
# These are set in the Dockerfile and are NOT substituted by docker-compose.yml,
# so putting them here does nothing. Changing them means editing the compose
# file's `environment:` block.
#
#   DATABASE_URL=/data/sage-burner.sqlite   on the named volume
#   WEB_ROOT=/app/apps/web/dist             the built frontend
#   HOST=0.0.0.0                            must stay reachable inside Docker
#                                           (the schema default is 127.0.0.1 —
#                                            binding wider needs SESSION_SECRET)
#   PORT=3000                               what the compose port mapping targets
